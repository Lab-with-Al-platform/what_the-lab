# 이 파일에는 실제 비밀값을 넣지 않습니다.
# 로컬에서는 이 파일을 .env로 복사한 뒤 개인 개발 값을 입력하세요.

APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 사용하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Discord OAuth (서버 전용, NEXT_PUBLIC_ 붙이지 말 것)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback

# JWT (서버 전용)
JWT_SECRET=""

# 인사이트는 PostgreSQL을 사용합니다. 회원 DB의 PostgreSQL 전환과는 별도입니다.
# 인사이트 첫 백엔드: 기본 비활성. 실제 Supabase 적용 전에는 활성화하지 않습니다.
INSIGHTS_ENABLED=false
# 로그인 사용자 중 인사이트 관리자에게 허용할 Discord ID. 비어 있으면 누구도 승인 불가.
INSIGHT_ADMIN_DISCORD_IDS=""
# 쿠키 로그인 쓰기 요청을 시작할 수 있는 화면 주소. 배포 시 실제 HTTPS 주소로 지정.
INSIGHT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 회원가입·로그인: 현재 develop의 MySQL 연결을 임시 유지합니다.
# PostgreSQL 전환 완료 전에는 DATABASE_URL만 바꿔 회원 DB를 연결할 수 없습니다.
# 아래 암호는 로컬 개발 예시이며 운영 환경에서는 사용하지 않습니다.
DB_HOST=127.0.0.1
DB_PORT=3309
DB_NAME=labbridge
DB_USER=labbridge_dev
DB_PASSWORD=dev1234
DB_ROOT_PASSWORD=root1234
