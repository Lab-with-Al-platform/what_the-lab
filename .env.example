# 이 파일에는 실제 비밀값을 넣지 않습니다.
# 로컬에서는 이 파일을 .env로 복사한 뒤 개인 개발 값을 입력하세요.

APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# PostgreSQL / Supabase
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 사용하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Discord OAuth (서버 전용, NEXT_PUBLIC_ 붙이지 말 것)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback

# JWT (서버 전용)
JWT_SECRET=""