# 이 파일에는 실제 비밀값을 넣지 않습니다.
# 로컬에서는 이 파일을 .env로 복사한 뒤 개인 개발 값을 입력하세요.

APP_ENV=development

# Frontend
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Backend
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# 공통 PostgreSQL 연결: 회원·내 이력·내 연구·인사이트·인사이트 migration이 함께 사용합니다.
# 팀 기본값은 Supabase입니다. Connect → Session pooler URL을 복사해 입력합니다.
# 아래는 모양만 보여주는 예시입니다. 실제 접속 값·암호는 안전한 별도 수단으로 전달합니다.
DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# 서버 전용 값입니다. NEXT_PUBLIC_ 접두사를 붙이거나 브라우저 코드에서 사용하지 마세요.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Discord OAuth (서버 전용, NEXT_PUBLIC_ 붙이지 말 것)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI=http://localhost:8000/api/v1/auth/discord/callback

# JWT (서버 전용)
JWT_SECRET=""

# 회원과 같은 PostgreSQL을 사용하되 insight_private schema로 데이터를 구분합니다.
# 인사이트 첫 백엔드: 기본 비활성. 실제 Supabase 적용 전에는 활성화하지 않습니다.
INSIGHTS_ENABLED=false
# 공통 users.is_admin=true인 활성 회원은 인사이트 관리자입니다.
# 아래 목록은 기존 인사이트 전용 관리자 지정의 호환 설정이며 공통 권한을 바꾸지 않습니다.
# is_admin=false이고 이 목록에도 없으면 승인 불가. 사용자명이나 Client ID가 아닌 Discord 사용자 ID.
INSIGHT_ADMIN_DISCORD_IDS=""
# 쿠키 로그인 쓰기 요청을 시작할 수 있는 화면 주소. 배포 시 실제 HTTPS 주소로 지정.
INSIGHT_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# 선택 사항: DATABASE_URL을 비운 경우에만 아래 로컬 Docker 대체 설정을 활성화합니다.
# 내 PC 안에서만 쓰는 개발용 값입니다. 배포(Supabase)에는 쓰지 않습니다.
# DB_HOST=127.0.0.1
# DB_PORT=5433
# DB_NAME=labbridge
# DB_USER=admin
# DB_PASSWORD=admin123
