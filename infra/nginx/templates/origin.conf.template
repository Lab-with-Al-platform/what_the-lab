# 운영 오리진(origin.<도메인>) 설정 틀이에요. (docs/aws-deployment/03-network-security.md 3절, B4)
# nginx 이미지가 시작할 때 환경변수 두 개를 채워 /etc/nginx/conf.d/origin.conf 로 만들어요.
#   ORIGIN_DOMAIN        예) origin.labbridge.kr
#   ORIGIN_VERIFY_SECRET CloudFront 오리진 사용자 지정 헤더 X-Origin-Verify 값 (영문·숫자만, openssl rand -hex 32)
# 환경변수가 아닌 $host 같은 nginx 변수는 그대로 남아요.

# 1) CloudFront 비밀 헤더가 맞는지: 맞으면 1, 아니면 0
map $http_x_origin_verify $origin_verified {
    default 0;
    "${ORIGIN_VERIFY_SECRET}" 1;
}

# 2) 컨테이너 안 상태 확인 전용 (밖으로 열지 않아요)
server {
    listen 127.0.0.1:8080;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "OK";
    }

    location / {
        return 404;
    }
}

# 3) 우리 오리진 이름이 아닌 HTTPS 연결(IP로 직접 접속 등)은 인증서도 보여 주지 않고 끊어요.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# 4) CloudFront → EC2 API 오리진
server {
    listen 443 ssl;
    server_name ${ORIGIN_DOMAIN};

    # Let's Encrypt DNS-01 인증서 (EC2의 /etc/letsencrypt 를 읽기 전용으로 연결)
    ssl_certificate     /etc/letsencrypt/live/${ORIGIN_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${ORIGIN_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 1h;

    # 비밀 헤더가 없거나 다르면 CloudFront를 거치지 않은 요청이에요.
    if ($origin_verified = 0) {
        return 403;
    }

    add_header X-Content-Type-Options nosniff always;

    # 아래 location 들이 함께 쓰는 backend 전달 설정
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Origin-Verify "";
    proxy_read_timeout 60s;
    proxy_connect_timeout 10s;

    # 로그인·디스코드 콜백·인증번호 발송: 엄격하게
    location /api/v1/auth/discord/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend_upstream;
    }

    # 인증번호 보내기·확인 (기관 검색 같은 조회는 아래 일반 API 제한)
    location ~ ^/api/v1/verification/(email|change)/(send|confirm)$ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://backend_upstream;
    }

    # 나머지 API
    location /api/v1/ {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://backend_upstream;
    }

    # 화면은 S3+CloudFront가 보내요. API 말고는 받지 않아요.
    location / {
        return 404;
    }
}
