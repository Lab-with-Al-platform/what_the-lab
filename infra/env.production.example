# docker-compose.prod.yml 이 읽는 값 목록이에요. 실제 값은 넣지 마세요 (저장소가 공개예요).
# 사용법: 이 파일을 저장소 루트의 .env.production 으로 복사해 값을 채운 뒤
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# 운영(EC2)에서는 배포 스크립트가 SSM Parameter Store(/labbridge/prod/*)에서 이 파일을 만들어요.
# 값 설명: docs/aws-deployment/05-discord-integration.md 5절

# 로컬 검증용 postgres 컨테이너 비밀번호 (운영은 RDS를 써서 B5에서 이 서비스를 뺄 예정)
POSTGRES_PASSWORD=

# 예: 로컬 검증 postgresql://admin:<POSTGRES_PASSWORD>@postgres:5432/labbridge
#     운영 postgresql://<앱 계정>:<비밀번호>@<RDS 주소>:5432/labbridge?sslmode=require
DATABASE_URL=

# 화면 주소. backend는 FRONTEND_URL 이 아니라 이 이름을 읽어요 (backend/app/config.py)
NEXT_PUBLIC_APP_URL=
CORS_ORIGINS=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 32자 이상 무작위. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
