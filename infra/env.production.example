# docker-compose.prod.yml 이 읽는 값 목록이에요. 실제 값은 넣지 마세요 (저장소가 공개예요).
# 사용법: 이 파일을 저장소 루트의 .env.production 으로 복사해 값을 채운 뒤
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d   (로컬 리허설)
#   EC2에서는 -f docker-compose.awslogs.yml 을 덧붙여요
# 운영(EC2)에서는 배포 스크립트가 SSM Parameter Store(/labbridge/prod/*)에서 이 파일을 만들어요.
# 값 설명: docs/aws-deployment/05-discord-integration.md 5절

# 운영 compose에는 postgres가 없어요 (DB는 RDS). 로컬 리허설은 내 PC의 PostgreSQL을 가리켜요.
# 예: 로컬 리허설 postgresql://<계정>:<비밀번호>@host.docker.internal:5432/labbridge
#     운영 postgresql://<앱 계정>:<비밀번호>@<RDS 주소>:5432/labbridge?sslmode=require
DATABASE_URL=

# 화면 주소. backend는 FRONTEND_URL 이 아니라 이 이름을 읽어요 (backend/app/config.py)
NEXT_PUBLIC_APP_URL=
CORS_ORIGINS=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# 32자 이상 무작위. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 운영(EC2)에서 받을 ECR 이미지 주소. 비워 두면 로컬 빌드 이름(labbridge-backend:local)을 써요.
# 예: <계정ID>.dkr.ecr.ap-northeast-2.amazonaws.com/labbridge-backend:<커밋 SHA>
BACKEND_IMAGE=
